FROM apache/airflow:2.9.2-python3.12

USER root

COPY backend/pyproject.toml /tmp/pyproject.toml

RUN python3 -c "\
import tomllib; \
deps = tomllib.load(open('/tmp/pyproject.toml','rb'))['project']['dependencies']; \
print('\n'.join(deps))" > /tmp/requirements-extracted.txt && \
    pip install --no-cache-dir \
    -r /tmp/requirements-extracted.txt \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.9.2/constraints-3.12.txt"

USER airflow