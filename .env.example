# ———— Required ——————————————————————————————————
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=you_gemini_api_key_here

# ———— PostgreSQL ————————————————————————————————
# These must match the value in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arxiv_rag

# "db" is the Docker Compose service name — not localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/arxiv_rag

# —— MLflow ——————————————————————————————————————
# "mlflow" is the Docker Compose service name; 5000 is the internal port
MLFLOW_TRACKING_URI=http://mlflow:5000

# —— Airflow —————————————————————————————————————
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Airflow uses its own database — same Postgres, different DB name
# Note: psycopg2 (sync driver), not asyncpg — Airflow is not async
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@db:5432/airflow

# Generate with: 
# python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

