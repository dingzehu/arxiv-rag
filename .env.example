# =============================================================================
# .env.example — copy this file to .env and fill in your values
# Run: chmod +x setup.sh && ./setup.sh
# (setup.sh creates .env and generates the Airflow secrets automatically)
# =============================================================================

# ———— Required ————————————————————————————————————————————————————————————————
# Get a free key at: https://aistudio.google.com/apikey
# Free tier is sufficient for this project.
GEMINI_API_KEY=your_gemini_api_key_here

# ———— PostgreSQL ——————————————————————————————————————————————————————————————
# These must match the values in docker-compose.yml
# "db" is the Docker Compose service name — not localhost
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=arxiv
POSTGRES_DB=arxiv
DATABASE_URL=postgresql+asyncpg://arxiv:arxiv@db:5432/arxiv

# ———— MLflow ——————————————————————————————————————————————————————————————————
# "mlflow" is the Docker Compose service name; 5000 is its internal port
# (mapped to 5001 on your host — open http://localhost:5001 in your browser)
MLFLOW_TRACKING_URI=http://mlflow:5000

# ———— Airflow ——————————————————————————————————————————————————————————————————
# Executor and database connection are configured in docker-compose.yml directly
# (SequentialExecutor + SQLite — correct for this project's sequential DAG).
# Only the cryptographic secrets are configured here.

# Encrypts sensitive values in Airflow's metadata database.
# Generated automatically by setup.sh — do not set this manually.
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# Signs Airflow's web UI session cookies to prevent forgery.
# Generated automatically by setup.sh — do not set this manually.
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here